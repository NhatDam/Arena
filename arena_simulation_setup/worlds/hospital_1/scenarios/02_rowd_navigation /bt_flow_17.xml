<?xml version='1.0' encoding='UTF-8'?>
<root main_tree_to_execute="ped_flow_17_tree" BTCPP_format="4">
    <TreeNodesModel>
        <Action ID="SetGoal">
            <input_port name="agent_id" type="int" />
            <input_port name="target_x" type="double" />
            <input_port name="target_y" type="double" />
            <input_port name="goal_id" type="int" />
        </Action>
        <Action ID="Wait">
            <input_port name="msec" type="int" />
        </Action>
    </TreeNodesModel>
    <include ros_pkg="arena_simulation_setup" path="configs/hunav/behavior_trees/BTRegularNav.xml" />
    <BehaviorTree ID="ped_flow_17_tree">
        <KeepRunningUntilFailure>
            <Sequence>
                <Wait msec="1200" />
                <SetGoal agent_id="{id}" goal_id="0" target_x="8.2" target_y="17.4" />
                <GoTo agent_id="{id}" goal_id="0" time_step="0.1" tolerance="0.15" />
                <SetGoal agent_id="{id}" goal_id="1" target_x="10.8" target_y="17.4" />
                <GoTo agent_id="{id}" goal_id="1" time_step="0.1" tolerance="0.15" />
            </Sequence>
        </KeepRunningUntilFailure>
    </BehaviorTree>
</root>
