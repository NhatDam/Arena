<?xml version='1.0' encoding='UTF-8'?>
<root main_tree_to_execute="triage_group_1_tree" BTCPP_format="4">
    <TreeNodesModel>
        <Action ID="SetGoal">
            <input_port name="agent_id" type="int" />
            <input_port name="target_x" type="double" />
            <input_port name="target_y" type="double" />
            <input_port name="goal_id" type="int" />
        </Action>
        <Action ID="Wait">
            <input_port name="msec" type="int" />
        </Action>
    </TreeNodesModel>
    <include ros_pkg="arena_simulation_setup" path="configs/hunav/behavior_trees/BTRegularNav.xml" />
    <BehaviorTree ID="triage_group_1_tree">
        <Sequence>
            <Wait msec="500" />
            <KeepRunningUntilFailure>
                <Sequence>
                    <SetGoal agent_id="{id}" goal_id="0" target_x="11.4" target_y="14.5" />
                    <GoTo agent_id="{id}" goal_id="0" time_step="0.1" tolerance="0.35" />
                    <SetGoal agent_id="{id}" goal_id="1" target_x="7.6" target_y="14.5" />
                    <GoTo agent_id="{id}" goal_id="1" time_step="0.1" tolerance="0.35" />
                </Sequence>
            </KeepRunningUntilFailure>
        </Sequence>
    </BehaviorTree>
</root>
