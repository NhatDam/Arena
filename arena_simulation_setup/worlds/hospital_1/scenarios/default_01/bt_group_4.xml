<?xml version='1.0' encoding='UTF-8'?>
<root main_tree_to_execute="triage_group_4_tree" BTCPP_format="4">
    <TreeNodesModel>
        <Action ID="SetGoal">
            <input_port name="agent_id" type="int" />
            <input_port name="target_x" type="double" />
            <input_port name="target_y" type="double" />
            <input_port name="goal_id" type="int" />
        </Action>
        <Action ID="StopAndWaitTimerAction">
            <input_port name="agent_id" type="int" />
            <input_port name="wait_duration" type="double" />
        </Action>
    </TreeNodesModel>
    <include ros_pkg="arena_simulation_setup" path="configs/hunav/behavior_trees/BTRegularNav.xml" />
    <BehaviorTree ID="triage_group_4_tree">
        <Sequence>
            <StopAndWaitTimerAction agent_id="{id}" wait_duration="1.5" />
            <KeepRunningUntilFailure>
                <Sequence>
                    <SetGoal agent_id="{id}" goal_id="0" target_x="9.5" target_y="8.5" />
                    <GoTo agent_id="{id}" goal_id="0" time_step="0.1" tolerance="0.35" />
                    <SetGoal agent_id="{id}" goal_id="1" target_x="9.5" target_y="28.5" />
                    <GoTo agent_id="{id}" goal_id="1" time_step="0.1" tolerance="0.35" />
                </Sequence>
            </KeepRunningUntilFailure>
        </Sequence>
    </BehaviorTree>
</root>
